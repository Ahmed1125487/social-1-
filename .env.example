# copy this file to .env.development (or .env.production) and fill the values
PORT=9000
APPLICATION_NAME=SocialApp

SALT=12

DB_URI=mongodb://127.0.0.1:27017/social_app
REDIS_URI=redis://127.0.0.1:6379

# ENC_KEY must be exactly 32 characters (AES-256), IV_LENGTH must stay 16
ENC_KEY=
IV_LENGTH=16

# use four different long random strings
ACCESS_USER_TOKEN_SIGNATURE=
ACCESS_ADMIN_TOKEN_SIGNATURE=
ACCESS_TOKEN_EXPIRES_IN=1800
REFRESH_USER_TOKEN_SIGNATURE=
REFRESH_ADMIN_TOKEN_SIGNATURE=
REFRESH_TOKEN_EXPIRES_IN=31536000

# Gmail app password. If APP_EMAIL is empty (development only) the OTP codes are printed in the console
APP_EMAIL=
APP_PASSWORD=

# Google client ids, comma separated
WEB_CLIENT_ID=

# allowed CORS origins, comma separated (empty = allow all)
ORIGINS=
RATE_LIMIT_MAX=30
